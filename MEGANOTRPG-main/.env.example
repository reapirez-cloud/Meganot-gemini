# Supabase Client Config (Frontend - Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional: Set to true if you want to bypass Telegram Mini App auth gate during local testing
VITE_ALLOW_LEGACY_BROWSER_SESSION=true

# Vercel Serverless Function Config (Backend /api/telegram-auth)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
